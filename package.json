{
  "name": "industry-intelligence-analyzer",
  "version": "2.0.0",
  "description": "Evidence-gated industry research and opportunity prioritization toolkit for AI-assisted commercial analysis.",
  "main": "src/process_industry.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/process_industry.js",
    "analyze": "node src/process_industry.js",
    "demo": "node src/process_industry.js examples/synthetic-demo/input.json --out examples/synthetic-demo/output",
    "verify": "node src/verifier.js examples/synthetic-demo/input.json",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/lint.js",
    "check": "npm run lint && npm test && npm run demo && npm run verify"
  },
  "keywords": [
    "industry-analysis",
    "market-sizing",
    "competitive-intelligence",
    "opportunity-scoring",
    "evidence-ledger",
    "ai-skill"
  ],
  "author": "muse05112003-cmyk",
  "license": "MIT"
}
